  "mcpServers": [
    {
      "id": "yi",
      "type": "local",
      "command": "$node",
      "args": ["${pluginRoot}/src/server.mjs"],
      "env": { "YI_PYTHON": "${config.pythonPath}" },
      "timeoutMs": 120000
    }
  ],
  "configuration": {
    "pythonPath": {
      "label": "Python 解释器路径",
      "description": "可选。留空时依次从 PATH 找 python / python3 / py。机器上 Python 不在 PATH 时，填 python.exe 的绝对路径（如 C:\\Python313\\python.exe）。",
      "required": false
    }
  },
  "environment": [
    { "name": "YI_PYTHON", "description": "可选。显式指定运行引擎的 Python 解释器；由插件配置「Python 解释器路径」注入，一般无需手工设置。", "required": false }
  ],
  "platforms": ["win32", "darwin", "linux"],
  "requiredCommands": []
