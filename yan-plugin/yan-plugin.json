{
  "schemaVersion": 1,
  "id": "yi-divination",
  "version": "1.0.0",
  "name": "Yi 术数（六爻 / 八字）",
  "description": "六爻纳甲与八字四柱的确定性排盘与解读。起卦、装卦、纳甲、世应、六亲、六神、旬空、旺衰、应期、格局全部由随包 Python 引擎计算，模型不得自行心算。知识库与排盘报告随包分发；古籍案例库按隔离纪律永不随包。库内一切分数是古籍案例对齐分，不是现实命中率。",
  "author": "Yi contributors",
  "license": "MIT",
  "instructions": "INSTRUCTIONS.md",
  "skills": [
    {
      "id": "yi-divination",
      "name": "Yi 术数排盘与解读",
      "description": "六爻纳甲与八字四柱的确定性排盘与解读。当用户提到六爻、摇卦起卦、占卜测吉凶、八卦、纳甲、用神、世应、应期，或八字、四柱、排盘、十神、格局、喜用神、大运流年时使用。所有排盘与推演由内置 Python 引擎完成。",
      "path": "skills/yi-divination/SKILL.md"
    }
  ],
