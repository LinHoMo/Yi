# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# 生成物（各学科内亦各自忽略，这里兜底）
outputs/
logs/
scratch/
*.tmp
# 门输出日志（各工作流把 check/评测输出直接重定向到仓库根或任意目录，
# 2026-10-01 实测仓库根散落 4 个 *.log，已移入 tools/scratch/logs-20261001/）。
# 全仓无被跟踪的 *.log（git ls-files '*.log' 为空），故通配不误伤；
# 将来若确有需入库的日志，用 `git add -f <file>` 显式豁免，不要放宽本条。
*.log
# 评测生成物与 --raise 抬升基线（脚本重跑生成，不入库）
**/data/cases/eval_*.json
check_baseline.json

# 真实应期反馈数据：恒定不入库（与古籍案例物理隔离，永不参与调参）
disciplines/*/data/feedback/
**/data/feedback/

# 合参层运行产物（人档案与指导，属用户数据，不入库）
synthesis/person/
synthesis/guidance/

# 索引与工具缓存（外部工具生成，不入库）
.codegraph/
.yanagent/
.trae-html-share-packages/
.preview/
.pytest_cache/
.archify/

# 编辑器与系统
.DS_Store
.idea/
.vscode/

.worktrees/

# 纯前端站点构建产物（tools/build_web.py 生成，Pages 工作流在 CI 里重建，不入库）
site/
_site/

# 生成物（AGENTS.md §三：*.html、*.jsonl 不入库，防误 add 报告/输出）。
# 白名单：web/index.html（前端源码）、docs/samples/**（留存样例，见 §三）。
*.html
!web/index.html
!docs/samples/**
*.jsonl

# 会话级工作记忆（agent 本地日志，不入库）
.workbuddy/memory/

# ci_request 本地调试产物（CI 内在 runner 临时目录生成，不入库）
/meta.json
/request.json
