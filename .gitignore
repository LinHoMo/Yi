devkit/handoff/

# 会话级工作记忆（agent 本地日志，不入库）
.workbuddy/memory/

# 学科内工具生成物（覆盖两科，用 **/ 前缀）
guard/
**/data/cases/blind_engine_output_*.json
**/data/cases/*_summary.json
**/scripts/regression_results.json
**/scripts/coverage_report.md
**/assets/portal_data.json

# DSH 插件：engine/ 与 skills/ 都是构建产物（由 scripts/build-*.mjs 按白名单从两科收集），
# 一条命令即可再生，故不入库——入库等于给「引擎/知识库 vs 两科真源」多存一份副本，
# 正是 AGENTS.md §二 警告过的「同表多存、取值不一致」事故土壤。
dsh-plugin/engine/
dsh-plugin/skills/
dsh-plugin/node_modules/
dsh-plugin/pnpm-lock.yaml
dsh-plugin/package-lock.json
# npm pack 产物（发布工件走 GitHub Release，不入库）
dsh-plugin/*.tgz

# 发布树（plugins/scripts/publish.mjs 产出，供各家 git 通道消费；不入库）
plugins/dist/

# plugins/：共享层（SKILL.md + mcp/ + scripts/）入库，engine/ 与 skills/ 是构建产物
plugins/engine/
plugins/skills/

# 各适配器里的共享运行时由 plugins/scripts/build.mjs 分发，属产物：
# 手工改它们会被 plugins/scripts/selftest.mjs [1] 段（逐字节同源门）判红。
dsh-plugin/src/*.mjs
dsh-plugin/src/*.json
!dsh-plugin/src/index.mjs
dsh-plugin/SKILL.md
yan-plugin/src/

# Yan Agent 插件：engine/ 与 skills/ 同为构建产物；yan-plugin.json、INSTRUCTIONS.md
# 等宿主专属文件是源，入库。
yan-plugin/engine/
yan-plugin/skills/
yan-plugin/node_modules/
yan-plugin/package-lock.json

# Codex / Gemini 插件：同为构建产物；各自的清单与上下文文件是源，入库。
codex-plugin/engine/
codex-plugin/skills/
codex-plugin/src/
gemini-plugin/engine/
gemini-plugin/skills/
gemini-plugin/src/

# Claude Code 插件：同为构建产物；.claude-plugin/plugin.json、.mcp.json 是源，入库。
claude-plugin/engine/
claude-plugin/skills/
claude-plugin/src/
claude-plugin/node_modules/
claude-plugin/package-lock.json

