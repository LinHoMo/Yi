{
  "schema": "yi-rule-engine-v2",
  "_comment": "阶段0最小闭环：从 detect_direction_caps 迁来的三条 v2 规则。when=卦象静态事实；gates=适用域；rescue_any=满足则解除。cap 档位/rule_id 与旧硬编码严格一致，保证 verdict 零漂移。",
  "rules": [
    {
      "rule_id": "liuyao.shi_hua_ke",
      "reason_key": "shi_hua_gui",
      "when": {"world_moving": true, "world_change_type": "回头克"},
      "rescue_any": [{"line_exists": {"six_relation": "子孙", "is_moving": true}}],
      "cap": "凶",
      "detail_tmpl": "世爻{world_branch}（{world_month_state}）独发动化回头克世（无子孙动解救），又化回头之克（世旺而不救：三合亦不宜变鬼）",
      "source": {"book": "增删卜易", "locator": "zengshan_buyi_dz.dz.txt:3625"}
    },
    {
      "rule_id": "liuyao.shi_huitou_sheng_yuepo",
      "reason_key": "shi_hua_gui",
      "when": {"world_moving": true, "world_change_type": "回头生", "changed_branch_chongs_month": true},
      "gates": {"qcls_not": ["行人", "功名科举"]},
      "cap": "凶",
      "detail_tmpl": "世爻{world_branch}动化{world_chg_branch}回头生，然{world_chg_branch}被月建冲破(月破)，原神生世无源",
      "source": {"book": "增删卜易", "locator": "zengshan_buyi_dz.dz.txt:222"}
    },
    {
      "rule_id": "liuyao.yongshen_hua_tui",
      "reason_key": "shi_hua_gui",
      "when": {"yongshen_moving": true, "yongshen_change_type_contains": "退"},
      "gates": {"qcls_not": ["行人"], "ug_cat_not": ["子孙"]},
      "cap": "凶",
      "detail_tmpl": "用神{ug_cat}动化退神（用神退散）",
      "source": {"book": "增删卜易", "locator": "zengshan_buyi_dz.dz.txt:948"}
    },
    {
      "rule_id": "liuyao.xiong_chi_shi_ke_cai",
      "reason_key": "xiong_chi_shi_ke_cai",
      "when": {"world_six_relation": "兄弟", "any_relation": "妻财"},
      "gates": {"qcls_eq": "婚姻"},
      "cap": "凶",
      "detail_tmpl": "兄弟{world_branch}持世，卦有妻财（克妻财之神临身）",
      "source": {"book": "增删卜易", "locator": "zengshan_buyi_dz.dz.txt:2613"}
    },
    {
      "rule_id": "liuyao.tianqi_zhan_yu",
      "reason_key": "tianqi_yun_cai_dong",
      "when": {"moving_relation": "妻财", "moving_or_changed_relation": {"not": "父母"}},
      "gates": {"qcls_eq": "天气·占雨"},
      "cap": "凶",
      "detail_tmpl": "占雨而财动父静（财动主晴）",
      "source": {"book": "黄金策", "locator": "huangjince_dz.dz.txt:300"}
    },
    {
      "rule_id": "liuyao.tianqi_zhan_qing",
      "reason_key": "tianqi_qing_fu_dong",
      "when": {"moving_or_changed_relation": "父母"},
      "gates": {"qcls_eq": "天气·占晴"},
      "cap": "凶",
      "detail_tmpl": "占晴而父母发动或化出父母（父动主雨）",
      "source": {"book": "卜筮全书", "locator": "bushi_quanshu_dz.dz.txt:5721"}
    },
    {
      "rule_id": "liuyao.qiu_cai_xiong_chi_shi",
      "reason_key": "qiu_cai_xiong_shi",
      "when": {"world_six_relation": "兄弟"},
      "gates": {"qcls_eq": "求财"},
      "rescue_any": [{"day_is_world_cai": true}, {"month_is_world_cai": true}],
      "cap": {"moving": "凶", "still": "平凶"},
      "detail_tmpl": "兄弟{world_branch}持世{world_moving_phrase}（占财兄爻为忌神）",
      "source": {"book": "增删卜易", "locator": "zengshan_buyi_dz.dz.txt:419"}
    },
    {
      "rule_id": "liuyao.chuxian_wuqing",
      "reason_key": "chuxian_wuqing",
      "when": {"guanfu_exists": true, "guanfu_sheng_he_exists": false},
      "gates": {"qcls_eq": "功名科举"},
      "cap": "凶",
      "detail_tmpl": "官鬼父母{guanfu_set_repr}出现，而不持世、不生不合世爻{world_branch}",
      "source": {"book": "增删卜易", "locator": "zengshan_buyi_dz.dz.txt:2786"}
    }
  ]
