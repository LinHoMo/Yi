  "verdict_rule": {
    "note": "综合裁决（学科自有口径，README 明示为规则应用非古籍定论）：黄黑道 ±1 为日辰第一权；建除对该活动宜 +1 / 忌 -1；星宿 ±0.5。总分 ≥1 → 吉；≤ -1 → 凶；其间 → 平（可行但有保留，宜择吉时）。",
    "thresholds": {
      "吉": 1.0,
      "凶": -1.0
    }
  },
