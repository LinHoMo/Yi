  "classical_interpretations": {
    "youhun": {
      "text": "游魂行无定，事主忧疑不定，心无归宿",
      "basis": "《卜筮正宗》游魂归魂章"
    },
    "youhun_traits": {
      "text": "行无方、四处飘荡、不定",
      "basis": "游魂卦特质"
    },
    "youhun_trait_home": {
      "text": "不安于室，思迁",
      "basis": "游魂卦特质"
    },
    "youhun_trait_mind": {
      "text": "忧疑不决，心思散乱",
      "basis": "游魂卦特质"
    },
    "guihun": {
      "text": "归魂回故乡，事主有归宿，终有所归",
      "basis": "《卜筮正宗》游魂归魂章"
    },
    "guihun_traits": {
      "text": "归期可定，终有所返",
      "basis": "归魂卦特质"
    },
    "guihun_trait_home": {
      "text": "安居乐业，归家安定",
      "basis": "归魂卦特质"
    },
    "guihun_trait_mind": {
      "text": "疑虑消解，心有所属",
      "basis": "归魂卦特质"
    },
    "youhun_dynamic": {
      "text": "往复飘摇，暂难定居",
      "basis": "游魂+动爻"
    },
    "guihun_dynamic": {
      "text": "反复纠结，终有归依",
      "basis": "归魂+动爻"
    },
    "not_youhun_guihun": {
      "text": "本卦非游魂归魂主事卦，不以游魂归魂论断",
      "basis": ""
    },
    "not_youhun_guihun_summary": {
      "text": "非游魂归魂卦——事态以常规世应生克为断，不涉飘泊依附之象",
      "basis": ""
    },
    "liuhe_hex": {
      "text": "六合卦主团聚、缠绵、迟缓、牵绊。",
      "basis": "《卜筮正宗·六合论》"
    },
    "liuhe_hex_2": {
      "text": "占事多主反复纠缠、不易决断、需要耐心。",
      "basis": "《卜筮正宗·六合论》"
    },
    "liuhe_hex_3": {
      "text": "占物则聚集不散，占病则缠绵难愈。",
      "basis": "《卜筮正宗·六合论》"
    },
    "liuhe_hex_4": {
      "text": "然若用神旺相，则六合亦可为吉，主聚合之象。",
      "basis": "《卜筮正宗·六合论》"
    },
    "liuchong_hex": {
      "text": "六冲卦主散、速决、分离、变动。",
      "basis": "《卜筮正宗·六冲论》"
    },
    "liuchong_hex_2": {
      "text": "占事多主动散不聚、难以坚守、事来事去迅速。",
      "basis": "《卜筮正宗·六冲论》"
    },
    "liuchong_hex_3": {
      "text": "占出行利，占散事宜，占聚合则不利。",
      "basis": "《卜筮正宗·六冲论》"
    },
    "liuchong_hex_4": {
      "text": "若用神休囚受克，则冲散太过，须防意外。",
      "basis": "《卜筮正宗·六冲论》"
    },
    "half_he_half_chong": {
      "text": "主事态复杂，表面和谐内有矛盾，或聚散交织需视具体情形而定。",
      "basis": ""
    },
    "has_he": {
      "text": "合处逢事宜斟酌，主有聚合之象但不完整。",
      "basis": ""
    },
    "has_chong": {
      "text": "冲处逢事宜谨慎，主有散动之象但不完整。",
      "basis": ""
    },
    "no_he_chong": {
      "text": "本卦各对应爻位无合无冲，平顺之象，吉凶需依用神决断。",
      "basis": ""
    },
    "fanyin_and_fuyin": {
      "text": "既反吟又伏吟，主反复多端、牵制难解、呻吟不止。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fanyin_and_fuyin_2": {
      "text": "事情反复无常，内心焦虑不安，是最不安定的卦象。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fanyin": {
      "text": "反吟主反复、变动不安、事多反复。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fanyin_2": {
      "text": "化反吟多为先成后败、先聚后散之象。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fanyin_3": {
      "text": "若用神旺相可解，主虽有波折终可成；若休囚则反复无定。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fuyin": {
      "text": "伏吟主呻吟不止、忧郁难舒、事有内心之苦。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fuyin_2": {
      "text": "占事多停滞不前、郁闷焦虑、欲行又止。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "fuyin_3": {
      "text": "宜静不宜动，宜守不宜攻。",
      "basis": "《卜筮正宗》反吟伏吟章"
    },
    "no_fanyin_fuyin": {
      "text": "本卦变爻无反吟伏吟，卦象安定。",
      "basis": ""
    },
    "no_moving_no_fanyin": {
      "text": "本卦无动爻，不存在反吟伏吟",
      "basis": ""
    },
    "twelve_changsheng": {
      "长生": {
        "text": "新生之象，事有先机，力量初萌",
        "basis": "十二长生"
      },
      "沐浴": {
        "text": "初生柔嫩，需防贻害，纯正尚待时日",
        "basis": "十二长生"
      },
      "冠带": {
