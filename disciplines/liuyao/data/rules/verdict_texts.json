        "basis": "十二长生"
      },
      "临官": {
        "text": "正当显达，力量充实，可担重任",
        "basis": "十二长生"
      },
      "帝旺": {
        "text": "极盛之时，力量最旺，盛极将衰之先",
        "basis": "十二长生"
      },
      "衰": {
        "text": "物极必反，力量开始减退",
        "basis": "十二长生"
      },
      "病": {
        "text": "力不从心，内耗渐显，弊端初露",
        "basis": "十二长生"
      },
      "死": {
        "text": "气数已尽，力量极微，难以作为",
        "basis": "十二长生"
      },
      "墓": {
        "text": "收藏归库，力量隐伏，待冲开方可",
        "basis": "十二长生"
      },
      "绝": {
        "text": "绝地无援，力量极弱，最难施为",
