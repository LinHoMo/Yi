      "weight": 1.4
    },
    "用神忌神齐动": {
      "condition": "用神与忌神（克用神之爻）同动",
      "meaning": "用忌齐动，吉凶交战",
      "advice": "用忌交战，胜负难料，看力量孰强",
      "weight": 1.4
    }
