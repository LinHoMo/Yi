      "weight": 1.5
    },
    "间隔动爻": {
      "condition": "动爻交替排列（如1、3、5或2、4、6）",
      "meaning": "事多枝节，一波未平一波又起",
      "advice": "动静相间，事有反复",
      "weight": 1.2
    },
    "上卦全动": {
      "condition": "上卦三爻（四、五、上）皆动",
      "meaning": "外局大变，局势动荡",
