  "sheng_ti_meaning": {
    "note": "《卷二·体用总诀》：卦中有生体之卦，看是何卦。互卦、变卦、用卦生体皆可套用。",
    "乾": "公门中有喜益，或功名上有喜，或因官有财，或问讼得理，或有金宝之利，或老人尊长进财",
    "坤": "有田土之喜，或得乡人之益，或得阴人之利，或有果谷布帛之喜",
    "震": "主山林之益，或因山林得财，或进东方之财，或因动中有喜，或有木货交易之利",
    "巽": "主山林之益，或于东南得财，或因草木姓人进利，或以茶果菜蔬得喜",
    "坎": "有北方之喜，或受北方之财，或水边人进利，或有鱼盐酒货文书交易之利",
    "离": "主有南方之财，或有文书之喜，或有炉冶场之利，或因火姓人而得财",
    "艮": "有东北方之财，或山田之喜，或因山林田土获财，物当安稳，事有终始",
    "兑": "有西方之财，或喜悦事，或有食物金玉货利之源，或主宾之乐，或朋友讲习之事"
  },
  "ke_ti_meaning": {
    "note": "《卷二·体用总诀》：卦中有克体之卦者，看是何卦。互卦、变卦、用卦克体皆可套用。",
    "乾": "主有公事之忧，或财宝之失，或于金谷有损，或怒于尊长，或得罪于贵人",
    "坤": "主有田土之忧，或阴人之侵，或小人之害，或失布帛之财，或丧谷粟之利",
    "震": "主有虚惊，常多恐惧，或家宅见妖灾，或草木姓氏之人相侵，或于山林有所失",
    "巽": "亦有草木姓人相害，或于山林上生忧",
    "坎": "主有险陷之事，或寇盗之忧，或失意于水边人，或生灾于酒后",
    "离": "主文书之忧，或失火之惊，或有南方之忧，或火人相害",
    "艮": "诸事多违，百谋中阻，或有山林田土之失，或防东北方之祸害",
    "兑": "不利西方，主口舌事之纷争，或有毁折之患，或因饮食而生忧"
  },
