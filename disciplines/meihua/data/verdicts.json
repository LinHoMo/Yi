  "multi_move_rules": {
    "note": "多爻动（两爻及以上）体用取舍与合参规则。《梅花易数》本法一爻动（爻以六除，总数除六之余）；两爻及以上动为通行扩展口径，供手工指定动爻或外部卦例校验。",
    "所本": "《梅花易数·卷一·爻以六除》一爻动为本法；《卷二·体用总诀》「体卦为主，用卦为事，互卦为事之中间，变卦为事之终」；《卷二·体用生克篇》「生体多者则愈吉，克体多者则愈凶」；《卷二·体用生克篇》「最切看互卦变卦，互变亦用也」；体用以动爻分：动者为用、静者为体（通行口径）。",
    "body_use": [
      "动爻尽在下卦（1–3）→ 上为体、下为用（与一爻动同，动者为用）",
      "动爻尽在上卦（4–6）→ 下为体、上为用",
      "上下皆有动爻 → 动爻多者所在卦为用，少者为体",
      "两卦动数相同 → 以初动爻（序号最小）所在卦为用"
    ],
    "changed": "诸动爻同时阴阳互变得变卦；互卦仍去初爻与上爻，二三四爻为下互、三四五爻为上互",
    "synthesis": "多爻动更重互变合参：用卦/互卦/变卦逐卦对体论生克，生体多者愈吉，克体多者愈凶；变卦定末后之期"
  },
